# App URL (optional, used for absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — server-only access (never expose service role to the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Signed cookie session secret (min 32 random characters)
SESSION_SECRET=replace-with-a-long-random-string

# API-Football — server-only, used for match previews
# Dashboard (api-sports): provider=apisports + key from Account → My Access
# RapidAPI: provider=rapidapi + RapidAPI key (different from dashboard key)
API_FOOTBALL_KEY=your-api-football-key
API_FOOTBALL_PROVIDER=apisports
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# RapidAPI alternative:
# API_FOOTBALL_PROVIDER=rapidapi
# API_FOOTBALL_BASE_URL=https://api-football-v1.p.rapidapi.com/v3
API_FOOTBALL_LEAGUE_ID=203
API_FOOTBALL_SEASON=2026
