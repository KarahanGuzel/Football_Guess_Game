# App URL (optional, used for absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional WhatsApp reminder target (international digits, no +)
# Leave empty to pick the group/chat manually when the button opens WhatsApp
# NEXT_PUBLIC_WHATSAPP_PHONE=905551112233

# Supabase — server-only access (never expose service role to the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Signed cookie session secret (min 32 random characters)
SESSION_SECRET=replace-with-a-long-random-string
